# Copy to .env. Never commit real secrets.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# memory = seeded in-memory demo data (the only driver wired up; see src/database/schema.sql for MySQL)
DB_DRIVER=memory

# Signs session tokens. REQUIRED in production (32+ random characters). If unset in development a random secret is
# generated each run, so sessions do not survive a restart.
# JWT_SECRET=
# bcrypt work factor for password hashing (4–15). 12 is a sensible production default.
BCRYPT_COST=12
# Send cookies over HTTPS only. Defaults to true when NODE_ENV=production and must not be false there.
# COOKIE_SECURE=false
# Where uploaded product photos are stored (served at /uploads)
UPLOAD_DIR=./uploads
# How often (minutes) the server re-checks stock freshness and raises alerts
SWEEP_INTERVAL_MIN=10
